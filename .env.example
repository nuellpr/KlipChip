# Salin file ini menjadi .env dan isi nilainya

# Lokasi database SQLite (relatif terhadap folder prisma/)
# dev lokal: file:./dev.db (akan jadi prisma/dev.db) atau absolute file:D:/KlipChip/prisma/dev.db
DATABASE_URL="file:./dev.db"

# Secret untuk menandatangani session cookie (HMAC-SHA256)
AUTH_SECRET="ganti-dengan-random-string-panjang"

# === Google OAuth (opsional tapi diperlukan agar tombol Google berfungsi) ===
# 1. Buat project di https://console.cloud.google.com
# 2. APIs & Services > Credentials > Create OAuth Client ID (Web application)
# 3. Authorized redirect URI: http://localhost:3000/api/auth/google/callback
#    (untuk produksi tambahkan https://domain-anda.com/api/auth/google/callback)
# 4. Copy Client ID & Client Secret ke bawah
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === Pembayaran: Mayar ===
# API key dari Mayar > Integration > API Key.
# Sandbox pakai domain web.mayar.io + api.mayar.io, dan key-nya BERBEDA dari
# produksi. Key produksi yang dipakai ke domain sandbox akan ditolak 401.
# MAYAR_API_TOKEN juga diterima sebagai nama alternatif; TOKEN diprioritaskan.
MAYAR_API_KEY=""

# 1 = paksa domain sandbox. Kosongkan = non-production otomatis sandbox,
# production otomatis api.mayar.id.
MAYAR_API_SANDBOX=""

# Override base URL (opsional, untuk proxy sendiri). Kosongkan = pakai default.
MAYAR_API_BASE=""

# === Highlight AI & ringkasan sosmed via OpenRouter ===
# API key dari https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model. Yang dipakai saat ini reasoning-first dan gratis, tapi jumlah thinking
# token-nya besar -- kalau sering dapat finish_reason=length, ganti model yang
# lebih ringan atau persingkat prompt.
MODEL_NAME="apodex/apodex-1.1-mini:free"

# Dikosongkan = pakai https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=""

# Model cadangan: dicoba kalau model utama gagal / kena rate limit.
# Kosongkan untuk mematikan fallback.
OPENROUTER_MODEL_FALLBACK=""
