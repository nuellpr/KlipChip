# Salin file ini menjadi .env dan isi nilainya

# Lokasi database SQLite (relatif terhadap folder prisma/)
# dev lokal: file:./dev.db (akan jadi prisma/dev.db) atau absolute file:D:/KlipChip/prisma/dev.db
DATABASE_URL="file:./dev.db"

# === Auth: Better Auth ===
# Base URL aplikasi, dipakai untuk redirect Google dan validasi Origin.
# WAJIB sesuai host yang dibuka browser.
# - Dev biasa: http://localhost:3000
# - Di belakang tunnel (ngrok): isi dengan host ngrok, mis.
#   https://abcd-123.ngrok-free.app
# Kalau diisi localhost tapi browser membuka host lain, sign-in/sign-out
# akan ditolak 403 oleh proteksi CSRF Better Auth.
BETTER_AUTH_URL="http://localhost:3000"

# Asal tambahan yang dipercayakan, dipisah koma. Kosongkan kalau tidak perlu.
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.1.2:3000"

# Di luar produksi, Better Auth otomatis mempercayai localhost (port 3000/3100)
# dan host tunnel dev (*.ngrok-free.app, *.ngrok-free.dev, *.ngrok.io,
# *.ngrok.app) supaya dev server di belakang ngrok tetap bisa sign-in/sign-out.
# Di PRODUKSI pola itu tidak aktif -- daftar host harus eksplisit di sini.
# BETTER_AUTH_ALLOWED_HOSTS="klipchip.app,www.klipchip.app"

# Secret untuk menandatangani session cookie.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-random-string-panjang"

# === Google OAuth (opsional) ===
# Tombol "Lanjutkan dengan Google" hanya muncul kalau keduanya diisi.
# Authorized redirect URI di Google Cloud HARUS persis:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === Pembayaran: Mayar ===
# API key dari Mayar > Integration > API Key.
# Sandbox pakai domain web.mayar.io + api.mayar.io, dan key-nya BERBEDA dari
# produksi. Key produksi yang dipakai ke domain sandbox akan ditolak 401.
# MAYAR_API_TOKEN juga diterima sebagai nama alternatif; TOKEN diprioritaskan.
MAYAR_API_KEY=""

# 1 = paksa domain sandbox. Kosongkan = non-production otomatis sandbox,
# production otomatis api.mayar.id.
MAYAR_API_SANDBOX=""

# Override base URL (opsional, untuk proxy sendiri). Kosongkan = pakai default.
MAYAR_API_BASE=""

# === Highlight AI & ringkasan sosmed via OpenRouter ===
# API key dari https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Model. Yang dipakai saat ini reasoning-first dan gratis, tapi jumlah thinking
# token-nya besar -- kalau sering dapat finish_reason=length, ganti model yang
# lebih ringan atau persingkat prompt.
MODEL_NAME="apodex/apodex-1.1-mini:free"

# Dikosongkan = pakai https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=""

# Model cadangan: dicoba kalau model utama gagal / kena rate limit.
# Kosongkan untuk mematikan fallback.
OPENROUTER_MODEL_FALLBACK=""
